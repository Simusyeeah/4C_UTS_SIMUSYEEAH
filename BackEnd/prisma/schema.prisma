// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  events    Event[]

  @@map("categories")
}
model Pembicara {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  image     String
  createdAt DateTime @default(now()) @map("created_at")

  events    Event[]

  @@map("pembicara")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String
  dateEvent   DateTime @map("date_event")

  categoryId  Int      @map("category_id")
  pembicaraId Int      @map("pembicara_id")

  createdAt   DateTime @default(now()) @map("created_at")

  category    Category  @relation(fields: [categoryId], references: [id])
  pembicara   Pembicara @relation(fields: [pembicaraId], references: [id])

  @@map("events")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Int
  stock       Int
  category    String
  image       String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("products")
}